APP_ENV=development
DATABASE_URL=sqlite:///./data/oi_profile.db

# demo | live
# live requires valid Dhan Data API subscription + credentials
DATA_MODE=demo

# Get from Dhan Web → Profile → Access DhanHQ APIs
# Never commit real values. Never put these in the Android app.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional backend API key for production hardening
API_KEY=
